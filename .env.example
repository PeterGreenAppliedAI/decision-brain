# Copy to .env (gitignored) and adjust. Every value shown is the default unless marked "set this".

# FalkorDB (docker compose publishes it on 6380)
FALKORDB_URL=redis://127.0.0.1:6380

# OpenAI-compatible model server for the extraction team and the agent — set this.
LLM_URL=http://127.0.0.1:8000/v1
LLM_MODEL=glm-5.3-flash
# GLM-5.3's chat template: low | high; unset means max (slow — see DECISIONS.md, Day 2)
LLM_REASONING_EFFORT=low
LLM_IDLE_TIMEOUT_MS=120000

# Where each graph's repo is checked out: lets review rebuild the decision log at a commit (CLI, MCP)
REPO_PATHS=

# One person under several git names: "alias=Name;alias2=Name"
PERSON_ALIASES=
# Author names matching this are recorded as AI agents, not humans
AGENT_AUTHOR_PATTERN=\b(claude|codex|copilot|gpt|gemini)\b

# Where repos keep ADRs (first that exists is ingested)
ADR_DIRS=docs/adr,docs/adrs,doc/adr,docs/architecture/decisions,docs/decisions,docs/architecture/adr,adr

# Rationale graph: files a recording commit touched that are not rationale
RATIONALE_EXCLUDE=**/*.lock,**/package-lock.json,**/yarn.lock,**/pnpm-lock.yaml,**/*.md
DISTINCTIVE_SEGMENT_SHARE=0.1
# Concepts on more than this share of entries link only broadly (ABOUT_BROADLY)
CONCEPT_MAX_SHARE=0.2
CONCEPT_MIN_COUNT=5

# Extraction team
CLAIM_TTL_MS=120000
MAX_ATTEMPTS=3
IDLE_POLL_MS=2000

# AI-agent instruction files (every version is ingested)
INSTRUCTION_FILES=**/AGENTS.md,**/CLAUDE.md,**/GEMINI.md,**/.cursorrules,**/.cursor/rules/**,**/.github/copilot-instructions.md,**/.windsurfrules

# File summaries
FILE_EXTENSIONS=ts,tsx,js,mjs,cjs,py,rb,go,rs,java,kt,cs,php,swift,c,h,cpp,sh,sql,erb,vue,svelte
FILE_EXCLUDE=**/node_modules/**,**/dist/**,**/build/**,**/vendor/**,**/coverage/**,**/*.min.*,**/*.d.ts,**/test/**,**/tests/**,**/spec/**,**/__tests__/**,**/*.test.*,**/*.spec.*
FILE_MAX_CHARS=40000

# Web views
WEB_HOST=127.0.0.1
WEB_PORT=4100
# Local use only: Sync and the demo steps on the Review page, and "Add repository" on the Board (clones a
# public GitHub repository and runs ingest + the team). Spends model time — never on a public deployment.
# (WEB_ALLOW_INGEST=1 is the older name and still works.)
WEB_LOCAL_ACTIONS=0
ADD_MAX_KB=200000
# At most this many Ask questions run on the model at once; more get "busy"
ASK_MAX_CONCURRENT=2
# MCP server: the graph used when a tool call names none (also --graph)
DEFAULT_GRAPH=
# Rows per write batch when loading large graphs
WRITE_BATCH=500
# Only for lib/llm.ts, the pre-event Ollama client (the product uses LLM_URL)
OLLAMA_URL=http://127.0.0.1:11434
# Search by meaning (optional): an OpenAI-compatible /embeddings endpoint, e.g. Ollama's /v1.
# Unset: search matches words only. EMBED_MAX_DISTANCE: cosine distance a meaning match must be within.
EMBED_URL=
EMBED_MODEL=qwen3-embedding:8b
EMBED_MAX_DISTANCE=0.44
