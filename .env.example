# Copy to .env (gitignored) and adjust. Every value shown is the default unless marked "set this".

# FalkorDB (docker compose publishes it on 6380)
FALKORDB_URL=redis://127.0.0.1:6380

# OpenAI-compatible model server for the extraction team and the agent — set this.
LLM_URL=http://127.0.0.1:8000/v1
LLM_MODEL=glm-5.3-flash
# GLM-5.3's chat template: low | high; unset means max (slow — see DECISIONS.md, Day 2)
LLM_REASONING_EFFORT=low
LLM_IDLE_TIMEOUT_MS=120000

# One person under several git names: "alias=Name;alias2=Name"
PERSON_ALIASES=
# Author names matching this are recorded as AI agents, not humans
AGENT_AUTHOR_PATTERN=\b(claude|codex|copilot|gpt|gemini)\b

# Where repos keep ADRs (first that exists is ingested)
ADR_DIRS=docs/adr,docs/adrs,doc/adr,docs/architecture/decisions,docs/decisions,docs/architecture/adr,adr

# Rationale graph: files a recording commit touched that are not rationale
RATIONALE_EXCLUDE=**/*.lock,**/package-lock.json,**/yarn.lock,**/pnpm-lock.yaml,**/*.md
DISTINCTIVE_SEGMENT_SHARE=0.1
# Concepts on more than this share of entries link only broadly (ABOUT_BROADLY)
CONCEPT_MAX_SHARE=0.2
CONCEPT_MIN_COUNT=5

# Extraction team
CLAIM_TTL_MS=120000
MAX_ATTEMPTS=3
IDLE_POLL_MS=2000

# Web views
WEB_HOST=127.0.0.1
WEB_PORT=4100
