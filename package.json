{
  "name": "decision-brain",
  "version": "0.0.0",
  "private": true,
  "description": "Graph Hacks 2026 entry (pre-event scaffold): an agent that answers why a codebase is the way it is, with the path behind every answer.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "graph:up": "docker compose up -d falkordb",
    "graph:down": "docker compose down",
    "ingest": "tsx --env-file-if-exists=.env src/ingest/cli.ts",
    "trace": "tsx --env-file-if-exists=.env src/tools/cli.ts",
    "team": "tsx --env-file-if-exists=.env src/team/cli.ts",
    "web": "tsx --env-file-if-exists=.env src/web/server.ts",
    "review": "tsx --env-file-if-exists=.env src/tools/review-cli.ts",
    "integrate": "tsx --env-file-if-exists=.env src/board/integrate-cli.ts",
    "mcp": "tsx --env-file-if-exists=.env src/mcp/server.ts",
    "ask": "tsx --env-file-if-exists=.env src/agent/cli.ts",
    "summarize": "tsx --env-file-if-exists=.env src/files/cli.ts",
    "eval:candidates": "tsx --env-file-if-exists=.env src/eval/candidates.ts",
    "eval:run": "tsx --env-file-if-exists=.env src/eval/run.ts",
    "eval:score": "tsx --env-file-if-exists=.env src/eval/run.ts --score",
    "eval:draft": "tsx --env-file-if-exists=.env src/eval/label-draft.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cytoscape": "^3.34.3",
    "falkordb": "^6.8.0",
    "zod": "^4.6.7"
  }
}
